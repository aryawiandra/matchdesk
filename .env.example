# Copy to .env for local runs. Never commit .env.
# Deployed code uses Microsoft Entra managed identity (DefaultAzureCredential); no key is needed there.
# Values below are placeholders, not real endpoints.

# Microsoft Foundry project endpoint and model deployment (names per Microsoft Learn, agent-framework Foundry provider page)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-model-deployment-name>

# Local development only, if you cannot use `az login`. Prefer `az login` + DefaultAzureCredential.
# AZURE_OPENAI_API_KEY=

# Cost guard: hard stop for live LLM calls per process, in US dollars
MATCHDESK_MAX_SPEND_USD=5

# Offline mode: deterministic templates instead of live models (used by CI and the fallback path)
MATCHDESK_OFFLINE=1
