# The app reads these from the process environment (it does not load a .env file): export them in the shell.
# Never commit a real .env or any key.

# Optional: enable the AI explainer (a local model behind the Verifier gate). Leave unset for templates only.
# Needs Ollama running with the model pulled:  ollama pull qwen2.5:3b
MATCHDESK_MODEL=ollama:qwen2.5:3b

# Optional: where Ollama listens. The default is http://localhost:11434
# OLLAMA_HOST=http://localhost:11434
