{
  "$defs": {
    "ExplanationOverlay": {
      "additionalProperties": false,
      "properties": {
        "a11y_text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "A11Y Text",
          "type": "string"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "lang": {
          "enum": [
            "en",
            "id",
            "es"
          ],
          "title": "Lang",
          "type": "string"
        },
        "match_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Match Id",
          "type": "string"
        },
        "overlay_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Overlay Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ExplanationPayload"
        },
        "persona": {
          "enum": [
            "fan",
            "analyst"
          ],
          "title": "Persona",
          "type": "string"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0.0,
          "title": "Start S",
          "type": "number"
        },
        "type": {
          "const": "explanation",
          "default": "explanation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "overlay_id",
        "match_id",
        "start_s",
        "end_s",
        "priority",
        "lang",
        "persona",
        "evidence_event_ids",
        "a11y_text",
        "payload"
      ],
      "title": "ExplanationOverlay",
      "type": "object"
    },
    "ExplanationPayload": {
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "items": {
            "$ref": "#/$defs/Sentence"
          },
          "minItems": 1,
          "title": "Sentences",
          "type": "array"
        }
      },
      "required": [
        "sentences"
      ],
      "title": "ExplanationPayload",
      "type": "object"
    },
