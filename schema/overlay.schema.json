  "discriminator": {
    "mapping": {
      "explanation": "#/$defs/ExplanationOverlay",
      "key_moment": "#/$defs/KeyMomentOverlay",
      "player_tag": "#/$defs/PlayerTagOverlay",
      "scoreboard": "#/$defs/ScoreboardOverlay"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ScoreboardOverlay"
    },
    {
      "$ref": "#/$defs/KeyMomentOverlay"
    },
    {
      "$ref": "#/$defs/ExplanationOverlay"
    },
    {
      "$ref": "#/$defs/PlayerTagOverlay"
    }
  ]
