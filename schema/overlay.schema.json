      ],
      "title": "KeyMomentOverlay",
      "type": "object"
    },
    "KeyMomentPayload": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Headline",
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "big_chance",
            "momentum_swing",
            "pressing_spell",
            "sprint_burst"
          ],
          "title": "Kind",
          "type": "string"
        },
        "team": {
          "enum": [
            "H",
            "A"
          ],
          "title": "Team",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "kind",
        "headline",
        "team"
      ],
      "title": "KeyMomentPayload",
      "type": "object"
    },
